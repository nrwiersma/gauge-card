  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "yaml": "^2.6.0"
  }
}
